# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments ---------------------------------------------------
.venv/
venv/
env/

# ---- Jupyter ----------------------------------------------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb

# ---- Testing / linting caches ----------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Data -------------------------------------------------------------------
# Raw and processed data are regenerated by the notebooks; do not version them.
data/raw/*
data/processed/*
data/external/*
!data/**/.gitkeep

# ---- MLOps artifacts (later modules) ----------------------------------------
mlruns/
mlartifacts/
*.pkl
*.joblib

# ---- OS / editor ------------------------------------------------------------
.DS_Store
.vscode/
.idea/

# ---- Claude Code ------------------------------------------------------------
# Machine-specific settings (tool permissions, local paths). The shared
# .claude/settings.json, if one is ever added, stays versioned.
.claude/settings.local.json
